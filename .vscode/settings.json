{
  "java.configuration.updateBuildConfiguration": "automatic",
  "code-runner.executorMapByGlob": {
    "BootstrapNode.java": "java \"$workspaceRoot/.vscode/RunComponent.java\" \"$fileNameWithoutExt\" \"$workspaceRoot\"",
    "WorkerNode.java": "java \"$workspaceRoot/.vscode/RunComponent.java\" \"$fileNameWithoutExt\" \"$workspaceRoot\"",
    "ClientGUI.java": "java \"$workspaceRoot/.vscode/RunComponent.java\" \"$fileNameWithoutExt\" \"$workspaceRoot\""
  },
  "code-runner.runInTerminal": true,
  "code-runner.ignoreSelection": true,
  "code-runner.saveFileBeforeRun": true,
  "files.exclude": {
    ".tools": true,
    ".demo": true,
    "**/target": true,
    "*.log": true
  },
  "java.autobuild.enabled": false
}
